<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PAM Assistant</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #f5f7fb;
            --surface: #ffffff;
            --surface-soft: #f8fafc;
            --border: #e5e7eb;

            --text: #172033;
            --muted: #6b7280;

            --primary: #315bea;
            --primary-dark: #2447c5;

            --success: #16a34a;
            --warning: #d97706;
            --danger: #dc2626;

            --shadow:
                0 10px 30px rgba(15, 23, 42, 0.07);

            --radius: 16px;
        }

        body {
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background:
                radial-gradient(
                    circle at top left,
                    rgba(49, 91, 234, 0.08),
                    transparent 30%
                ),
                var(--bg);

            color: var(--text);

            height: 100vh;
            overflow: hidden;
        }

        /* ================================
           APPLICATION
        ================================= */

        .app {
            display: flex;
            height: 100vh;
        }

        /* ================================
           SIDEBAR
        ================================= */

        .sidebar {
            width: 280px;

            background: rgba(255,255,255,0.92);

            border-right: 1px solid var(--border);

            padding: 22px 18px;

            display: flex;
            flex-direction: column;

            backdrop-filter: blur(18px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;

            padding: 4px 8px 24px;
        }

        .brand-icon {
            width: 42px;
            height: 42px;

            border-radius: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;

            font-size: 20px;
            font-weight: 700;

            background:
                linear-gradient(
                    135deg,
                    #315bea,
                    #6d5dfc
                );

            box-shadow:
                0 8px 18px rgba(49, 91, 234, 0.25);
        }

        .brand-text h2 {
            font-size: 17px;
        }

        .brand-text span {
            font-size: 12px;
            color: var(--muted);
        }

        .new-chat {
            width: 100%;

            border: 1px solid #dbe3ff;

            background: #f4f7ff;

            color: var(--primary);

            padding: 12px;

            border-radius: 12px;

            font-weight: 600;

            cursor: pointer;

            transition: 0.2s;
        }

        .new-chat:hover {
            background: #eaf0ff;
            transform: translateY(-1px);
        }

        .sidebar-title {
            font-size: 11px;

            text-transform: uppercase;

            letter-spacing: 0.08em;

            color: #9ca3af;

            margin:

                28px 8px 10px;
        }

        .quick-menu {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .menu-item {
            padding: 11px 12px;

            border-radius: 10px;

            cursor: pointer;

            font-size: 13px;

            color: #4b5563;

            transition: 0.2s;
        }

        .menu-item:hover {
            background: #f3f5f9;
            color: var(--text);
        }

        .menu-item.active {
            background: #edf2ff;
            color: var(--primary);
            font-weight: 600;
        }

        .security-card {
            margin-top: auto;

            background:
                linear-gradient(
                    135deg,
                    #f0fdf4,
                    #f7fee7
                );

            border: 1px solid #dcfce7;

            border-radius: 14px;

            padding: 14px;
        }

        .security-card-title {
            display: flex;
            gap: 8px;

            align-items: center;

            font-size: 13px;

            font-weight: 700;

            margin-bottom: 6px;
        }

        .security-card p {
            color: #64748b;

            font-size: 11px;

            line-height: 1.5;
        }

        /* ================================
           MAIN
        ================================= */

        .main {
            flex: 1;

            display: flex;
            flex-direction: column;

            min-width: 0;
        }

        /* ================================
           HEADER
        ================================= */

        .header {
            height: 72px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 28px;

            background:
                rgba(255,255,255,0.86);

            border-bottom: 1px solid var(--border);

            backdrop-filter: blur(16px);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .bot-avatar {
            width: 38px;
            height: 38px;

            border-radius: 11px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #315bea,
                    #755cf6
                );

            font-weight: 700;
        }

        .header-info h1 {
            font-size: 15px;
        }

        .header-info p {
            font-size: 11px;
            color: var(--muted);

            display: flex;
            align-items: center;
            gap: 6px;
        }

        .online-dot {
            width: 7px;
            height: 7px;

            background: #22c55e;

            border-radius: 50%;

            box-shadow:
                0 0 0 4px rgba(34,197,94,0.1);
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .role-badge {
            padding: 7px 12px;

            border-radius: 20px;

            background: #f1f5f9;

            color: #475569;

            font-size: 11px;

            font-weight: 600;
        }

        .user-avatar {
            width: 35px;
            height: 35px;

            border-radius: 50%;

            background: #172033;

            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 12px;

            font-weight: 700;
        }

        /* ================================
           CHAT
        ================================= */

        .chat-area {
            flex: 1;

            overflow-y: auto;

            padding: 36px 10% 140px;
        }

        .welcome {
            max-width: 780px;

            margin: 40px auto 30px;

            text-align: center;
        }

        .welcome-icon {
            width: 64px;
            height: 64px;

            margin: auto auto 18px;

            border-radius: 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;

            font-size: 27px;

            background:
                linear-gradient(
                    135deg,
                    #315bea,
                    #725cf7
                );

            box-shadow:
                0 14px 30px rgba(49,91,234,0.22);
        }

        .welcome h2 {
            font-size: 27px;

            letter-spacing: -0.03em;

            margin-bottom: 8px;
        }

        .welcome p {
            color: var(--muted);

            font-size: 14px;

            line-height: 1.6;
        }

        /* ================================
           SUGGESTIONS
        ================================= */

        .suggestions {
            max-width: 780px;

            margin: 25px auto;

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 10px;
        }

        .suggestion {
            background: white;

            border: 1px solid var(--border);

            padding: 15px;

            border-radius: 13px;

            text-align: left;

            cursor: pointer;

            transition:
                transform 0.2s,
                box-shadow 0.2s,
                border 0.2s;
        }

        .suggestion:hover {
            transform: translateY(-2px);

            border-color: #cbd5ff;

            box-shadow:
                0 8px 22px rgba(15,23,42,0.06);
        }

        .suggestion-icon {
            margin-bottom: 9px;

            font-size: 17px;
        }

        .suggestion strong {
            display: block;

            font-size: 13px;

            margin-bottom: 4px;
        }

        .suggestion span {
            color: var(--muted);

            font-size: 11px;
        }

        /* ================================
           MESSAGES
        ================================= */

        .message {
            max-width: 820px;

            margin: 18px auto;

            display: flex;

            gap: 12px;

            animation:
                messageIn 0.25s ease;
        }

        @keyframes messageIn {

            from {
                opacity: 0;
                transform: translateY(7px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        .message.user {
            justify-content: flex-end;
        }

        .message-avatar {
            width: 31px;
            height: 31px;

            flex-shrink: 0;

            border-radius: 9px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 12px;

            font-weight: 700;
        }

        .bot-message .message-avatar {
            color: white;

            background:
                linear-gradient(
                    135deg,
                    #315bea,
                    #755cf6
                );
        }

        .user-message .message-avatar {
            color: white;

            background: #172033;
        }

        .bubble {
            max-width: 75%;

            padding: 13px 16px;

            border-radius: 14px;

            font-size: 13px;

            line-height: 1.65;
        }

        .bot-message .bubble {
            background: white;

            border: 1px solid var(--border);

            border-top-left-radius: 4px;

            box-shadow:
                0 4px 15px rgba(15,23,42,0.035);
        }

        .user-message .bubble {
            background: #315bea;

            color: white;

            border-top-right-radius: 4px;
        }

        .message-time {
            font-size: 9px;

            color: #9ca3af;

            margin-top: 5px;
        }

        /* ================================
           PAM RESULT CARD
        ================================= */

        .pam-card {
            margin-top: 12px;

            border: 1px solid #e5e7eb;

            border-radius: 12px;

            overflow: hidden;

            background: #fff;
        }

        .pam-card-header {
            padding: 11px 13px;

            background: #f8fafc;

            border-bottom: 1px solid #e5e7eb;

            display: flex;

            justify-content: space-between;

            align-items: center;
        }

        .pam-card-title {
            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: .05em;
        }

        .status {
            font-size: 10px;

            font-weight: 700;

            padding: 4px 8px;

            border-radius: 20px;
        }

        .status.success {
            color: #15803d;
            background: #dcfce7;
        }

        .status.warning {
            color: #a16207;
            background: #fef9c3;
        }

        .status.danger {
            color: #b91c1c;
            background: #fee2e2;
        }

        .pam-row {
            display: flex;

            justify-content: space-between;

            padding: 10px 13px;

            border-bottom: 1px solid #f1f5f9;

            font-size: 11px;
        }

        .pam-row:last-child {
            border-bottom: none;
        }

        .pam-label {
            color: #64748b;
        }

        .pam-value {
            font-weight: 600;
        }

        /* ================================
           INPUT
        ================================= */

        .composer-wrapper {
            position: fixed;

            bottom: 0;

            left: 280px;
            right: 0;

            padding:
                18px
                10%
                22px;

            background:
                linear-gradient(
                    to top,
                    var(--bg) 70%,
                    transparent
                );
        }

        .composer {
            max-width: 820px;

            margin: auto;

            background: white;

            border: 1px solid #dfe3ea;

            border-radius: 17px;

            box-shadow:
                0 12px 35px rgba(15,23,42,0.10);

            padding: 8px;

            display: flex;

            align-items: flex-end;

            transition: 0.2s;
        }

        .composer:focus-within {
            border-color: #a9b9ff;

            box-shadow:
                0 12px 40px rgba(49,91,234,0.13);
        }

        textarea {
            flex: 1;

            resize: none;

            border: none;

            outline: none;

            padding: 10px 12px;

            font-family: inherit;

            font-size: 13px;

            min-height: 42px;

            max-height: 130px;

            color: var(--text);
        }

        textarea::placeholder {
            color: #9ca3af;
        }

        .send-button {
            width: 42px;
            height: 42px;

            border: none;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    #315bea,
                    #5b55ed
                );

            color: white;

            cursor: pointer;

            font-size: 16px;

            transition: 0.2s;
        }

        .send-button:hover {
            transform: translateY(-2px);

            box-shadow:
                0 7px 15px rgba(49,91,234,0.25);
        }

        .send-button:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

        .composer-hint {
            text-align: center;

            color: #9ca3af;

            font-size: 9px;

            margin-top: 8px;
        }

        /* ================================
           TYPING
        ================================= */

        .typing {
            display: flex;

            gap: 4px;

            padding: 4px;
        }

        .typing span {
            width: 6px;
            height: 6px;

            background: #94a3b8;

            border-radius: 50%;

            animation:
                typing 1.2s infinite;
        }

        .typing span:nth-child(2) {
            animation-delay: .15s;
        }

        .typing span:nth-child(3) {
            animation-delay: .3s;
        }

        @keyframes typing {

            0%, 60%, 100% {
                transform: translateY(0);
                opacity: .5;
            }

            30% {
                transform: translateY(-4px);
                opacity: 1;
            }

        }

        /* ================================
           RESPONSIVE
        ================================= */

        @media(max-width: 850px) {

            .sidebar {
                display: none;
            }

            .composer-wrapper {
                left: 0;
            }

            .chat-area {
                padding-left: 20px;
                padding-right: 20px;
            }

            .suggestions {
                grid-template-columns: 1fr;
            }

            .bubble {
                max-width: 88%;
            }

            .header {
                padding: 0 15px;
            }

            .role-badge {
                display: none;
            }

        }

    </style>
</head>

<body>

<div class="app">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">
                🛡
            </div>

            <div class="brand-text">
                <h2>PAM Assistant</h2>
                <span>Privileged Access Management</span>
            </div>

        </div>


        <button
            class="new-chat"
            onclick="clearChat()">

            ＋ New conversation

        </button>


        <div class="sidebar-title">
            PAM Actions
        </div>


        <div class="quick-menu">

            <div
                class="menu-item active"
                onclick="quickMessage('Search my accounts')">

                🔎 Search Accounts

            </div>

            <div
                class="menu-item"
                onclick="quickMessage('Show my safe permissions')">

                🔐 Review Permissions

            </div>

            <div
                class="menu-item"
                onclick="quickMessage('Show active platforms')">

                🖥 Platform Status

            </div>

            <div
                class="menu-item"
                onclick="quickMessage('Show my credential metadata')">

                🔑 Credential Metadata

            </div>

            <div
                class="menu-item"
                onclick="quickMessage('Show the recertification status')">

                ✓ Recertification

            </div>

        </div>


        <div class="security-card">

            <div class="security-card-title">

                🟢

                <span>PAM Security Active</span>

            </div>

            <p>
                Requests are evaluated against authorization,
                entitlement and PAM policy before information is disclosed.
            </p>

        </div>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main">


        <!-- HEADER -->

        <header class="header">

            <div class="header-left">

                <div class="bot-avatar">
                    P
                </div>

                <div class="header-info">

                    <h1>PAM AI Assistant</h1>

                    <p>
                        <span class="online-dot"></span>
                        Secure session active
                    </p>

                </div>

            </div>


            <div class="header-right">

                <div class="role-badge">
                    PAM User
                </div>

                <div class="user-avatar">
                    U
                </div>

            </div>

        </header>


        <!-- CHAT -->

        <section
            class="chat-area"
            id="chatArea">

            <div
                class="welcome"
                id="welcome">

                <div class="welcome-icon">
                    🛡
                </div>

                <h2>
                    How can I help with PAM?
                </h2>

                <p>
                    Search accounts, review permissions,
                    check platforms, review recertification
                    status and understand credential access.
                </p>

            </div>


            <div
                class="suggestions"
                id="suggestions">

                <div
                    class="suggestion"
                    onclick="quickMessage('Search my accounts')">

                    <div class="suggestion-icon">
                        🔎
                    </div>

                    <strong>
                        Search accounts
                    </strong>

                    <span>
                        Find authorized accounts and status
                    </span>

                </div>


                <div
                    class="suggestion"
                    onclick="quickMessage('Show my safe permissions')">

                    <div class="suggestion-icon">
                        🔐
                    </div>

                    <strong>
                        Review permissions
                    </strong>

                    <span>
                        Check safe and account permissions
                    </span>

                </div>


                <div
                    class="suggestion"
                    onclick="quickMessage('Show active platforms')">

                    <div class="suggestion-icon">
                        🖥
                    </div>

                    <strong>
                        Platform status
                    </strong>

                    <span>
                        View active PAM platforms
                    </span>

                </div>


                <div
                    class="suggestion"
                    onclick="quickMessage('Show recertification status')">

                    <div class="suggestion-icon">
                        ✓
                    </div>

                    <strong>
                        Recertification
                    </strong>

                    <span>
                        Review pending access recertification
                    </span>

                </div>

            </div>

        </section>


        <!-- COMPOSER -->

        <div class="composer-wrapper">

            <div class="composer">

                <textarea
                    id="messageInput"
                    placeholder="Ask PAM Assistant..."
                    rows="1"
                    onkeydown="handleKey(event)"
                ></textarea>


                <button
                    id="sendButton"
                    class="send-button"
                    onclick="sendMessage()">

                    ➤

                </button>

            </div>


            <div class="composer-hint">

                PAM Assistant can only disclose information
                permitted by your authorization and policy.

            </div>

        </div>

    </main>

</div>


<script>

    /* =========================================================
       LANGFLOW CONFIGURATION
    ========================================================= */

    const LANGFLOW_URL =
        "https://echelon.langflow.auria.dev/echonet/api/v1/run/8019a959-5d39-4c31-aced-21791a495cb7?stream=false";


    /*
       IMPORTANT:

       Do NOT commit a real API key to GitHub or production
       frontend code.

       For demo/testing you can temporarily place it here.

       Better architecture:

       Browser
          ↓
       Your backend
          ↓
       Langflow
    */

    const API_KEY =
        "YOUR_API_KEY_HERE";


    /* =========================================================
       SESSION
    ========================================================= */

    let SESSION_ID =
        localStorage.getItem("pam_session_id");


    if (!SESSION_ID) {

        SESSION_ID =
            crypto.randomUUID();

        localStorage.setItem(
            "pam_session_id",
            SESSION_ID
        );

    }


    /* =========================================================
       ELEMENTS
    ========================================================= */

    const input =
        document.getElementById("messageInput");

    const chatArea =
        document.getElementById("chatArea");

    const sendButton =
        document.getElementById("sendButton");

    const welcome =
        document.getElementById("welcome");

    const suggestions =
        document.getElementById("suggestions");


    /* =========================================================
       ENTER KEY
    ========================================================= */

    function handleKey(event) {

        if (
            event.key === "Enter" &&
            !event.shiftKey
        ) {

            event.preventDefault();

            sendMessage();

        }

    }


    /* =========================================================
       QUICK MESSAGE
    ========================================================= */

    function quickMessage(message) {

        input.value = message;

        sendMessage();

    }


    /* =========================================================
       ADD USER MESSAGE
    ========================================================= */

    function addUserMessage(message) {

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "message user user-message";


        wrapper.innerHTML = `

            <div class="bubble">

                ${escapeHTML(message)}

                <div class="message-time">
                    ${getTime()}
                </div>

            </div>

            <div class="message-avatar">
                U
            </div>

        `;


        chatArea.appendChild(wrapper);

        scrollToBottom();

    }


    /* =========================================================
       ADD BOT MESSAGE
    ========================================================= */

    function addBotMessage(message) {

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "message bot-message";


        wrapper.innerHTML = `

            <div class="message-avatar">
                P
            </div>

            <div>

                <div class="bubble">

                    ${formatResponse(message)}

                    <div class="message-time">
                        ${getTime()}
                    </div>

                </div>

            </div>

        `;


        chatArea.appendChild(wrapper);

        scrollToBottom();

    }


    /* =========================================================
       TYPING INDICATOR
    ========================================================= */

    function showTyping() {

        const wrapper =
            document.createElement("div");

        wrapper.id =
            "typingIndicator";

        wrapper.className =
            "message bot-message";


        wrapper.innerHTML = `

            <div class="message-avatar">
                P
            </div>

            <div class="bubble">

                <div class="typing">

                    <span></span>
                    <span></span>
                    <span></span>

                </div>

            </div>

        `;


        chatArea.appendChild(wrapper);

        scrollToBottom();

    }


    function removeTyping() {

        const typing =
            document.getElementById(
                "typingIndicator"
            );

        if (typing) {
            typing.remove();
        }

    }


    /* =========================================================
       SEND MESSAGE
    ========================================================= */

    async function sendMessage() {

        const message =
            input.value.trim();


        if (!message) {
            return;
        }


        addUserMessage(message);


        input.value = "";

        input.style.height = "42px";

        welcome.style.display = "none";

        suggestions.style.display = "none";


        sendButton.disabled = true;

        showTyping();


        try {

            const response =
                await fetch(
                    LANGFLOW_URL,
                    {

                        method: "POST",

                        headers: {

                            "Content-Type":
                                "application/json",

                            "x-api-key":
                                API_KEY

                        },


                        body: JSON.stringify({

                            output_type: "chat",

                            input_type: "chat",

                            input_value:
                                message,

                            session_id:
                                SESSION_ID

                        })

                    }
                );


            if (!response.ok) {

                throw new Error(
                    `Langflow returned HTTP ${response.status}`
                );

            }


            const data =
                await response.json();


            removeTyping();


            const answer =
                extractLangflowResponse(data);


            addBotMessage(answer);


        }

        catch (error) {

            console.error(error);

            removeTyping();


            addBotMessage(
                "I couldn't reach the PAM service right now. Please try again. If the issue continues, the PAM service may require escalation."
            );

        }

        finally {

            sendButton.disabled = false;

            input.focus();

        }

    }


    /* =========================================================
       EXTRACT LANGFLOW RESPONSE
    ========================================================= */

    function extractLangflowResponse(data) {

        /*
            Langflow response structures can vary depending
            on the flow/output configuration.

            This function tries several common locations.
        */


        if (
            typeof data === "string"
        ) {
            return data;
        }


        const candidates = [

            data?.outputs?.[0]?.outputs?.[0]?.results?.message?.text,

            data?.outputs?.[0]?.outputs?.[0]?.messages?.[0]?.message,

            data?.outputs?.[0]?.outputs?.[0]?.results?.message?.data?.text,

            data?.outputs?.[0]?.outputs?.[0]?.results?.message?.data,

            data?.outputs?.[0]?.outputs?.[0]?.text,

            data?.outputs?.[0]?.message,

            data?.message,

            data?.text,

            data?.response

        ];


        for (const candidate of candidates) {

            if (
                typeof candidate === "string" &&
                candidate.trim()
            ) {

                return candidate;

            }

        }


        /*
            Last resort:
            show JSON rather than pretending
            the request succeeded with an empty answer.
        */

        return JSON.stringify(
            data,
            null,
            2
        );

    }


    /* =========================================================
       FORMAT RESPONSE
    ========================================================= */

    function formatResponse(text) {

        if (!text) {
            return "";
        }


        let html =
            escapeHTML(text);


        /*
            Convert simple markdown-like formatting.
        */

        html =
            html.replace(
                /\*\*(.*?)\*\*/g,
                "<strong>$1</strong>"
            );


        html =
            html.replace(
                /`([^`]+)`/g,
                "<code>$1</code>"
            );


        html =
            html.replace(
                /\n/g,
                "<br>"
            );


        return html;

    }


    /* =========================================================
       ESCAPE HTML
    ========================================================= */

    function escapeHTML(value) {

        return String(value)
            .replace(
                /&/g,
                "&amp;"
            )
            .replace(
                /</g,
                "&lt;"
            )
            .replace(
                />/g,
                "&gt;"
            )
            .replace(
                /"/g,
                "&quot;"
            )
            .replace(
                /'/g,
                "&#039;"
            );

    }


    /* =========================================================
       TIME
    ========================================================= */

    function getTime() {

        return new Date()
            .toLocaleTimeString(
                [],
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            );

    }


