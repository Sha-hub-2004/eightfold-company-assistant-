def _fmt_item(it):
    if "item_id" in it:
        who = it.get("account_id") or it.get("principal")
        s = f"- **{it['item_id']}** {it.get('type')} · {who} · {it.get('safe_id')} · owner: {it.get('owner') or 'MISSING'} · {it.get('status')}"
        return s + (f" ({it['note']})" if it.get("note") else "")
    if "memberships" in it:
        rows = [f"- **{it.get('name')}** ({it['safe_id']})"]
        rows += [f"  - {m['principal']} ({m['principal_type']}): {', '.join(m['permissions'])}" for m in it["memberships"]]
        return "\n".join(rows)
    if "effective_permissions" in it:
        via = f" (inherited via {', '.join(it['inherited_from'])})" if it.get("inherited_from") else ""
        return f"- **{it['safe_id']}** - your permissions: {', '.join(it['effective_permissions'])}{via}"
    if "anomalous_permissions" in it:
        return (f"- **{it['principal']}** holds {', '.join(it['anomalous_permissions'])} on {it['safe_id']}; "
                f"granted by {it.get('granted_by')}; approval: {it.get('approval_id') or 'none'}")
    if "display_name" in it:
        return f"- **{it['display_name']}** ({it['platform_id']}) · {it.get('category')} · rotation: {'yes' if it.get('supports_rotation') else 'no'}"
    if "request_id" in it:
        return f"- Request **{it['request_id']}** - {it['status']}"
    if "username" in it:
        s = (f"- **{it['account_id']}** {it['username']} · {it.get('hostname') or it.get('asset_id')} · "
             f"{it.get('safe_id')} · {it.get('status')}")
        if it.get("rotation_status"):
            s += f" · rotation {it['rotation_status']}"
        for k, lab in (("last_rotated_at", "last rotated"), ("next_rotation_at", "next rotation"), ("checkout_policy", "checkout")):
            if it.get(k):
                s += f" · {lab}: {it[k]}"
        return s
    if "hostname" in it:
        return f"- {it['hostname']} ({it['asset_id']})"
    return "- " + ", ".join(f"{k}: {v}" for k, v in it.items())


def render(res):
    d, r, items = res["decision"], res["reason_code"], res.get("results") or []
    out = []
    sm = res.get("summary")
    if sm:
        out.append(f"**{sm['campaign']}** (due {sm['due_date']}): {sm['total_items']} items - {sm['certified']} certified, "
                   f"{sm['pending']} pending, {sm['error']} in error - **{sm['completion_pct']}% complete**.")
    if d == "ANSWER":
        out.append("Here's what I found:" if items else "No matching results are available to you for that request.")
    elif d == "PARTIAL":
        out.append("Here's what I can show (sensitive fields are withheld):")
    elif d == "DENY":
        out.append("I can't help with that. " + _DENY_MSG.get(r, ""))
    elif d == "ESCALATE":
        out.append("This has been flagged and routed:" if items else "Escalated:")
    out += [_fmt_item(i) for i in items] if d != "CLARIFY" else []
    if res.get("follow_up"):
        out.append(res["follow_up"])
    out.append(f"_Decision: {d} · {r}_")
    return "\n\n".join(x for x in out if x)


