_PAM_WORDS = re.compile(r"account|safe|permission|platform|credential|password|secret|recertif|access|"
                        r"checkout|metadata|svc_|acc-\d|member|host|asset|rotat|entitle|@agent", re.I)
_MODIFY = re.compile(r"\b(delete|remove|create|grant|revoke|modify|change|reset|rotate|disable|enable|unlock|approve|reject|certify|add me|onboard)\b", re.I)
_FILTER_WORDS = {"disabled", "active", "rotation", "failed", "fail", "whose", "success"}
_NL_STOP = set("""find search show list give me my the a an for of in on at to from with and or is are do does
have has what which who why how please can you i we us account accounts service credential credentials detail
details metadata info information application app authorized safes safe named name that this all every current
database production prod uat dev agent get review permissions permission members member here""".split())


def _find_safe(low, store):
    lt = _toks(low)
    best = None
    for s in store.get("safes", []):
        if s["safe_id"].lower() in low:
            return s["safe_id"]
        nt = _toks(s.get("name", ""))
        if nt and nt <= lt and (best is None or len(nt) > best[0]):
            best = (len(nt), s["safe_id"])
    return best[1] if best else None


def parse_query(text, store):
    """Rule-based intent + parameter extraction (no LLM needed)."""
    raw = text or ""
    parts = re.split(r"(?<=[.!?])\s+", raw.strip())
    clean = " ".join(s for s in parts if not _INJECTION.search(s)) or raw
    low = re.sub(r"^\s*@agent\s*", "", clean.lower())
    p = {"user_query": raw}
    if not _PAM_WORDS.search(clean):
        return "UNSUPPORTED", p
    if _MODIFY.search(low):
        return "MODIFY", p
    m = re.search(r"acc-\d+", low)
    if m:
        p["account_id"] = m.group(0).upper()
    hy = re.search(r"\b[a-z0-9]+(?:-[a-z0-9]+)+\b", low)
    host = hy.group(0) if hy and not re.match(r"acc-\d+$", hy.group(0)) else None
    has_safe_word = bool(re.search(r"\bsafe\b", low))

    if "recertif" in low:
        intent = "RECERTIFICATION_STATUS"
        for word, st in (("error|fail", "error"), ("pending|outstanding|open", "pending"), ("certified|completed|done", "certified")):
            if re.search(word, low):
                p["status"] = st
                break
        if has_safe_word and _find_safe(low, store):
            p["safe"] = _find_safe(low, store)
        return intent, p
    if re.search(r"\b(password|passwd|secret|private key|api token|token)\b", low) and \
            re.search(r"\b(print|show|give|reveal|display|tell|read|see|get|need|what)\b", low):
        return "GET_SECRET", p
    if re.search(r"request (access|checkout|credential)|need access|check ?out|approval|get access", low):
        intent = "REQUEST_CREDENTIAL_ACCESS"
    elif re.search(r"permission|manage safe|entitle", low) or \
            (re.search(r"\bmembers?\b", low) and not re.search(r"\baccounts?\b", low)):
        intent = "REVIEW_SAFE_PERMISSIONS"
        p["safe"] = _find_safe(low, store)
        return intent, p
    elif re.search(r"platform", low):
        if re.search(r"database|\bdb\b", low):
            p["category"] = "database"
        return "LIST_PLATFORMS", p
    elif re.search(r"credential|metadata|last rotated|checkout policy", low):
        intent = "GET_CREDENTIAL_METADATA"
    else:
        intent = "SEARCH_ACCOUNTS"

    removed = set()
    if intent == "SEARCH_ACCOUNTS":
        if has_safe_word and _find_safe(low, store):
            p["safe"] = _find_safe(low, store)
        else:
            if re.search(r"\bprod(uction)?\b", low):
                p["environment"] = "prod"
            elif re.search(r"\buat\b", low):
                p["environment"] = "uat"
        m = re.search(r"\b(disabled|active)\b", low)
        if m:
            p["status"] = m.group(1)
        if re.search(r"rotat", low) and re.search(r"fail", low):
            p["rotation_status"] = "failed"
        for pl in store.get("platforms", []):
            pt = _toks(pl["platform_id"]) - {"plat"}
            if pt and pt <= _toks(low) and len(pt) >= 2:
                p["platform"] = " ".join(sorted(pt))
                removed |= pt
    if host:
        p["keyword"] = host
    elif not p.get("account_id"):
        words = [_SYN.get(w, w) for w in re.findall(r"[a-z0-9]+", low)]
        kw = [w for w in words if w not in _NL_STOP and w not in _FILTER_WORDS and w not in removed]
        if p.get("safe"):
            kw = []
        if kw:
            p["keyword"] = " ".join(kw)
    return intent, p


def run_nl(text, req, store, recert=None, outage="off"):
    intent, p = parse_query(text, store)
    if intent == "MODIFY":
        res = _resp("DENY", "ACTION_NOT_SUPPORTED",
                    follow_up="I only look things up. I don't create, change, grant, revoke, approve or certify anything. "
                              "Use the PAM access-governance workflow for changes.")
        res["intent"] = intent
        return res, p
    if intent in ("REVIEW_SAFE_PERMISSIONS",) and not p.get("safe"):
        res = _resp("CLARIFY", "MISSING_SAFE", follow_up="Which safe do you mean? Please give the safe name.")
        res["intent"] = intent
        return res, p
    if intent in ("GET_CREDENTIAL_METADATA", "REQUEST_CREDENTIAL_ACCESS") and not (p.get("keyword") or p.get("account_id")):
        res = _resp("CLARIFY", "MISSING_TARGET", follow_up="Which account ID or hostname do you mean?")
        res["intent"] = intent
        return res, p
    res = evaluate(intent, p, req, store, store.get("policy", {}), recert, outage)
    return res, p


