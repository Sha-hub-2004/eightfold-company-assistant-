# ----------------------------------------------------------------- constants
SUPPORTED_INTENTS = [
    "SEARCH_ACCOUNTS", "REVIEW_SAFE_PERMISSIONS", "LIST_PLATFORMS",
    "GET_CREDENTIAL_METADATA", "GET_SECRET", "REQUEST_CREDENTIAL_ACCESS",
    "RECERTIFICATION_STATUS",
]
SECRET_FIELDS = ["secret", "password", "private_key", "api_token"]
PRIV_PERMS = {"manage_safe"}
AUTH_RANK = {"sso": 1, "mfa": 2}
GOV_FOLLOW_UP = ("Request access through the PAM access-governance workflow "
                 "if there is a business need.")
DEFAULT_META_FIELDS = ["account_id", "username", "asset_id", "safe_id", "platform_id",
                       "status", "last_rotated_at", "next_rotation_at", "checkout_policy"]
_SYN = {"production": "prod", "prd": "prod"}
_SAFE_STOP = {"safe", "safes", "the", "a", "my", "of"}
_KW_STOP = {"the", "a", "an", "for", "of", "my", "on", "in", "account", "accounts", "service",
            "application", "app", "credential", "credentials", "details", "database", "prod", "uat", "dev"}
_INJECTION = re.compile(
    r"(ignore (all |any |the |previous |prior )*(access|instructions|controls|rules)|"
    r"system override|reveal (all|every)|disregard|bypass (the )?(access|polic))", re.I)


class ServiceUnavailable(Exception):
    pass


# ------------------------------------------------------------------- helpers
def _toks(text):
    return {_SYN.get(t, t) for t in re.split(r"[^a-z0-9]+", str(text or "").lower()) if t}


def _authorized(req, safe_id):
    ids = req.get("authorized_safe_ids", [])
    return "*" in ids or safe_id in ids


def _is_admin(req):
    return req.get("role") == "pam_admin"


def _resp(decision, reason, results=None, follow_up=None, redactions=None, summary=None):
    return {"decision": decision, "reason_code": reason, "results": results or [],
            "follow_up": follow_up, "redactions": redactions or [], "summary": summary}


def public_view(res):
    """What the LLM / user may see. Redaction details stay in the audit log only."""
    out = {k: res[k] for k in ("decision", "reason_code", "results", "follow_up") if k in res}
    if res.get("summary"):
        out["summary"] = res["summary"]
    if res.get("attempts", 1) > 1:
        out["attempts"] = res["attempts"]
    return out


def _resolve_safes(text, safes):
    q = _toks(text) - _SAFE_STOP
    if not q:
        return []
    raw = str(text).strip().lower()
    exact = [s for s in safes if raw in (s["safe_id"].lower(), s.get("name", "").lower())]
    if exact:
        return exact
    return [s for s in safes if q <= _toks(s["safe_id"] + " " + s.get("name", ""))]


def _match(a, p, assets, platforms):
    asset = assets.get(a.get("asset_id"), {})
    if p.get("keyword"):
        kw = _toks(p["keyword"]) - _KW_STOP
        hay = _toks(" ".join([a.get("account_id", ""), a.get("username", ""), a.get("asset_id", ""),
                              asset.get("hostname", ""), asset.get("application", "")]))
        if not kw <= hay:
            return False
    if p.get("environment"):
        env = a.get("environment") or asset.get("environment")
        if _toks(p["environment"]) != _toks(env):
            return False
    if p.get("status") and str(a.get("status", "")).lower() != p["status"].lower():
        return False
    if p.get("rotation_status") and str(a.get("rotation_status", "")).lower() != p["rotation_status"].lower():
        return False
    if p.get("platform"):
        plat = platforms.get(a.get("platform_id"), {})
        hay = _toks(a.get("platform_id", "") + " " + plat.get("display_name", "") + " " + plat.get("category", ""))
        if not (_toks(p["platform"]) - {"platform", "accounts"}) <= hay:
            return False
    return True


def _public_account(a):
    out = {k: a[k] for k in ("account_id", "username", "asset_id", "safe_id", "platform_id", "status") if k in a}
    if "rotation_status" in a:
        out["rotation_status"] = a["rotation_status"]
    return out


def _join_or(items):
    return items[0] if len(items) == 1 else ", ".join(items[:-1]) + " or " + items[-1]


def _label(a):
    u = a.get("username", "").lower()
    return "read-only" if u.endswith("_ro") else "read-write" if u.endswith("_rw") else a.get("username", "")


def _maps(ctx):
    return ({a["asset_id"]: a for a in ctx.get("assets", [])},
            {p["platform_id"]: p for p in ctx.get("platforms", [])})


def _secret_redactions(ctx):
    return SECRET_FIELDS if any(a.get("secret_present") for a in ctx.get("accounts", [])) else ["secret", "password"]


# ------------------------------------------------------------------ handlers
def _search_accounts(p, req, ctx, policy, recert):
    assets, plats = _maps(ctx)
    accounts = ctx.get("accounts", [])
    scoped = accounts
    if p.get("safe"):
        safes = _resolve_safes(p["safe"], ctx.get("safes", []))
        if len(safes) > 1:
            return _resp("CLARIFY", "MULTIPLE_SAFE_MATCHES",
                         follow_up="Which safe do you mean? Please give the exact safe name.")
        if safes:
            sid = safes[0]["safe_id"]
            if not _authorized(req, sid):
                hidden = [a["account_id"] for a in accounts if a.get("safe_id") == sid]
                return _resp("DENY", "SAFE_NOT_AUTHORIZED", follow_up=GOV_FOLLOW_UP,
                             redactions=hidden + [sid, "safe_memberships"])
            scoped = [a for a in accounts if a.get("safe_id") == sid]
        else:
            scoped = []
    hidden_ids = [a["account_id"] for a in accounts if not _authorized(req, a.get("safe_id"))]
    matched = [a for a in scoped if _authorized(req, a.get("safe_id")) and _match(a, p, assets, plats)]
    red = list(hidden_ids)
    if any(a.get("description") for a in accounts):
        red.append("account_description")
    if any(a.get("secret_present") for a in accounts):
        red += ["secret", "password"]
    injected = _INJECTION.search(p.get("user_query", "")) or any(
        _INJECTION.search(a.get("description", "")) for a in accounts if a in matched)
    results = [_public_account(a) for a in matched]
    if injected:
        return _resp("PARTIAL", "PROMPT_INJECTION_IGNORED", results, redactions=red)
    if not results:
        return _resp("ANSWER", "NO_AUTHORIZED_MATCHES", redactions=red)
    return _resp("ANSWER", "ADMIN_ACCOUNT_MATCHES" if _is_admin(req) else "AUTHORIZED_ACCOUNT_MATCHES",
                 results, redactions=red)


def _review_permissions(p, req, ctx, policy, recert):
    safes = _resolve_safes(p.get("safe", ""), ctx.get("safes", []))
    if not safes:
        return _resp("ANSWER", "NO_AUTHORIZED_MATCHES")
    if len(safes) > 1:
        return _resp("CLARIFY", "MULTIPLE_SAFE_MATCHES", follow_up="Which safe do you mean? Please give the exact safe name.")
    s = safes[0]
    if not _authorized(req, s["safe_id"]):
        return _resp("DENY", "SAFE_NOT_AUTHORIZED", follow_up=GOV_FOLLOW_UP,
                     redactions=[s["safe_id"], "safe_memberships"])
    members = s.get("memberships", [])
    if _is_admin(req):
        prod = "prod" in _toks(s["safe_id"] + " " + s.get("name", ""))
        anomalies = []
        if prod and policy.get("production_manage_safe_requires_approval", True):
            for m in members:
                bad = [x for x in m.get("permissions", []) if x in PRIV_PERMS]
                if bad and not m.get("approval_id"):
                    anomalies.append({"safe_id": s["safe_id"], "principal": m["principal"],
                                      "anomalous_permissions": bad,
                                      "granted_by": m.get("granted_by"), "approval_id": m.get("approval_id")})
        if anomalies:
            return _resp("ESCALATE", "UNAPPROVED_PRIVILEGED_GRANT", anomalies,
                         "Open a PAM security review for the unapproved privileged grant; "
                         "do not revoke access automatically from the chatbot.")
        mem = [{k: m[k] for k in ("principal", "principal_type", "permissions")} for m in members]
        return _resp("ANSWER", "ADMIN_SAFE_REVIEW_AUTHORIZED",
                     [{"safe_id": s["safe_id"], "name": s.get("name"), "memberships": mem}])
    perms, via = [], []
    for m in members:
        if m["principal"] == req["user_id"] or m["principal"] in req.get("groups", []):
            for x in m.get("permissions", []):
                if x not in perms:
                    perms.append(x)
            if m["principal"] != req["user_id"]:
                via.append(m["principal"])
    if not perms:
        return _resp("ANSWER", "NO_AUTHORIZED_MATCHES", redactions=["other_safe_members"])
    return _resp("ANSWER", "AUTHORIZED_EFFECTIVE_PERMISSIONS",
                 [{"safe_id": s["safe_id"], "principal": req["user_id"],
                   "effective_permissions": perms, "inherited_from": via}],
                 redactions=["other_safe_members"])


def _list_platforms(p, req, ctx, policy, recert):
    plats = ctx.get("platforms", [])
    active = [x for x in plats if x.get("status") == "active"]
    if p.get("category"):
        q = _toks(p["category"]) - {"platform", "platforms"}
        active = [x for x in active if q <= _toks(x.get("category", "") + " " + x.get("display_name", "") + " " + x["platform_id"])]
    keep = ("platform_id", "display_name", "category", "supports_rotation", "supports_reconciliation")
    res = [{k: x[k] for k in keep} for x in active]
    red = [x["platform_id"] for x in plats if x.get("status") != "active"]
    return _resp("ANSWER", "ACTIVE_PLATFORM_MATCHES" if res else "NO_AUTHORIZED_MATCHES", res, redactions=red)


def _candidates(p, ctx):
    assets, plats = _maps(ctx)
    accs = ctx.get("accounts", [])
    if p.get("account_id"):
        return [a for a in accs if a["account_id"].lower() == p["account_id"].lower()]
    if not p.get("keyword"):
        return []
    return [a for a in accs if _match(a, {"keyword": p["keyword"], "environment": p.get("environment")}, assets, plats)]


def _credential_metadata(p, req, ctx, policy, recert):
    assets, _ = _maps(ctx)
    cands = _candidates(p, ctx)
    auth = [a for a in cands if _authorized(req, a.get("safe_id"))]
    if not cands:
        return _resp("ANSWER", "NO_AUTHORIZED_MATCHES")
    if not auth:
        return _resp("DENY", "SAFE_NOT_AUTHORIZED", follow_up=GOV_FOLLOW_UP,
                     redactions=[a["account_id"] for a in cands] + ["secret"])
    need = policy.get("metadata_requires_authentication_level", "mfa")
    if any(a.get("checkout_policy") == "step_up_mfa_required" for a in auth):
        need = "mfa"
    if AUTH_RANK.get(req.get("authentication_level"), 0) < AUTH_RANK.get(need, 2):
        return _resp("DENY", "STEP_UP_AUTHENTICATION_REQUIRED",
                     follow_up="Complete MFA step-up authentication and retry the request.",
                     redactions=["account_metadata", "secret"])
    if len(auth) > 1:
        hosts, seen = [], set()
        for a in auth:
            h = assets.get(a.get("asset_id"), {})
            if a.get("asset_id") not in seen:
                seen.add(a.get("asset_id"))
                hosts.append({"asset_id": a.get("asset_id"), "hostname": h.get("hostname", a.get("asset_id"))})
        labels = list(dict.fromkeys(_label(a) for a in auth))
        names = [h["hostname"] for h in hosts]
        if len(hosts) > 1:
            q = "Which asset do you mean: " + _join_or(names)
            q += (", and do you need the " + _join_or(labels) + " account?") if len(labels) > 1 else "?"
        else:
            q = f"Which account on {names[0]} do you mean: {_join_or(labels)}?"
        return _resp("CLARIFY", "MULTIPLE_ASSET_OR_ACCOUNT_MATCHES", hosts, q)
    a = auth[0]
    fields = [f for f in policy.get("credential_metadata_fields", DEFAULT_META_FIELDS) if f != "checkout_portal_path"]
    out = {f: a[f] for f in fields if f in a}
    out["hostname"] = assets.get(a.get("asset_id"), {}).get("hostname")
    path = a.get("checkout_portal_path", f"/accounts/{a['account_id']}/checkout")
    return _resp("PARTIAL", "AUTHORIZED_METADATA_SECRET_REDACTED", [out],
                 f"Use the approved checkout workflow at {path}; do not display the secret in chat.",
                 redactions=list(SECRET_FIELDS))


def _get_secret(p, req, ctx, policy, recert):
    cands = _candidates(p, ctx)
    ok = len(cands) == 1 and _authorized(req, cands[0].get("safe_id"))
    fu = (f"Use the approved checkout workflow at /accounts/{cands[0]['account_id']}/checkout."
          if ok else "Use the approved checkout workflow in the PAM portal.")
    return _resp("DENY", "SECRET_DISCLOSURE_PROHIBITED", follow_up=fu, redactions=["secret", "password"])


def _request_access(p, req, ctx, policy, recert):
    cands = _candidates(p, ctx)
    if not cands:
        return _resp("ANSWER", "NO_AUTHORIZED_MATCHES")
    if len(cands) > 1:
        return _resp("CLARIFY", "MULTIPLE_ASSET_OR_ACCOUNT_MATCHES",
                     follow_up="Please give the exact account ID or hostname you need.")
    stamp = datetime.now(timezone.utc).isoformat()
    rid = "REQ-" + hashlib.sha1((req["user_id"] + cands[0]["account_id"] + stamp).encode()).hexdigest()[:8].upper()
    return _resp("ESCALATE", "APPROVAL_REQUIRED",
                 [{"request_id": rid, "status": "routed_to_admin_approval"}],
                 "Your request was sent to the PAM admin approval queue. No credential is shown in chat; "
                 "access is released only after sign-off via the checkout workflow.",
                 redactions=list(SECRET_FIELDS))


def _recert_status(p, req, ctx, policy, recert):
    if not _is_admin(req):
        return _resp("DENY", "ROLE_NOT_PERMITTED",
                     follow_up="Recertification status is available to PAM admins. Please contact your PAM admin.")
    items = (recert or {}).get("items", [])
    total = len(items)
    cnt = {s: sum(1 for i in items if i["status"] == s) for s in ("certified", "pending", "error")}
    summary = {"campaign": (recert or {}).get("campaign"), "due_date": (recert or {}).get("due_date"),
               "total_items": total, **cnt,
               "completion_pct": round(100 * cnt["certified"] / total, 1) if total else 0.0,
               "missing_owner_total": sum(1 for i in items if not i.get("owner"))}
    sel = [i for i in items if i["status"] != "certified"]
    if p.get("status"):
        sel = [i for i in items if i["status"] == p["status"].lower()]
    if p.get("safe"):
        sf = _resolve_safes(p["safe"], ctx.get("safes", []))
        sel = [i for i in sel if sf and i["safe_id"] == sf[0]["safe_id"]]
    res = [{**i, "flag": "MISSING_OWNER - not auto-processed"} if not i.get("owner") else dict(i) for i in sel]
    missing = [i["item_id"] for i in sel if not i.get("owner")]
    if missing:
        return _resp("PARTIAL", "MISSING_OWNER_FLAGGED", res,
                     f"Assign an accountable owner for {', '.join(missing)}. These items were skipped and "
                     "nothing was auto-certified; the admin has been notified.", summary=summary)
    return _resp("ANSWER", "RECERT_STATUS_COMPILED", res, summary=summary)


HANDLERS = {
    "SEARCH_ACCOUNTS": _search_accounts, "REVIEW_SAFE_PERMISSIONS": _review_permissions,
    "LIST_PLATFORMS": _list_platforms, "GET_CREDENTIAL_METADATA": _credential_metadata,
    "GET_SECRET": _get_secret, "REQUEST_CREDENTIAL_ACCESS": _request_access,
    "RECERTIFICATION_STATUS": _recert_status,
}


# ------------------------------------------------------------------ core API
def _call_with_retry(fn, mode):
    """Golden scenario 4: say so plainly, retry once, then escalate to on-call."""
    for attempt in (1, 2):
        try:
            if mode == "down" or (mode == "flaky" and attempt == 1):
                raise ServiceUnavailable("PAM vault / CMDB API unavailable")
            res = fn()
            res["attempts"] = attempt
            return res
        except ServiceUnavailable:
            continue
    inc = "INC-" + datetime.now(timezone.utc).strftime("%y%m%d-%H%M%S")
    res = _resp("ESCALATE", "PAM_API_UNAVAILABLE",
                follow_up=f"The PAM vault/CMDB API is unavailable. I retried once and escalated to the "
                          f"PAM engineering on-call ({inc}). No data was returned.")
    res["attempts"] = 2
    return res


def evaluate(intent, params, requester, ctx, policy, recert=None, outage="off"):
    intent = (intent or "").strip().upper()
    p = {k: (v.strip() if isinstance(v, str) else v) for k, v in (params or {}).items() if v not in (None, "")}
    if intent not in HANDLERS:
        res = _resp("CLARIFY", "UNSUPPORTED_OR_UNCLEAR_INTENT",
                    follow_up="I can search accounts, review safe permissions, list platforms, show credential "
                              "metadata, request credential access, and report recertification status. Which do you need?")
    else:
        res = _call_with_retry(lambda: HANDLERS[intent](p, requester, ctx, policy, recert), outage)
    res["intent"] = intent
    return res


def audit_entry(req, intent, params, res):
    return {"ts": datetime.now(timezone.utc).isoformat(), "user_id": req.get("user_id"),
            "role": req.get("role"), "intent": intent,
            "params": {k: v for k, v in params.items() if v}, "decision": res["decision"],
            "reason_code": res["reason_code"], "redactions": res.get("redactions", []),
            "attempts": res.get("attempts", 1)}


# ---------------------------------------------------------- Langflow component
class PamGuardTool(Component):
    display_name = "PAM Mock Backend + Policy Guard"
    description = ("Deterministic PAM lookups over mock data with role/safe/MFA enforcement, "
                   "redaction, retry/escalation and audit logging. Enable Tool Mode and connect to the Agent.")
    icon = "shield"
    name = "PamGuardTool"

    inputs = [
        MessageTextInput(name="data_dir", display_name="Data folder (optional)", value="",
                         info="Leave empty to use the built-in mock data. Optional folder with pam_store.json / recertification.json"),
        MessageTextInput(name="user_id", display_name="Logged-in user ID", value="usr-alex",
                         info="Identity comes from the flow, never from the LLM. Try usr-alex, usr-morgan, usr-sam, adm-priya."),
        MessageTextInput(name="outage_mode", display_name="Simulate outage (off | flaky | down)", value="off"),
        MessageTextInput(name="intent", display_name="Intent", tool_mode=True,
                         info="One of: " + ", ".join(SUPPORTED_INTENTS)),
        MessageTextInput(name="keyword", display_name="Keyword", tool_mode=True,
                         info="Account name, hostname, application or account ID mentioned by the user"),
        MessageTextInput(name="account_id", display_name="Account ID", tool_mode=True, info="e.g. ACC-1001"),
        MessageTextInput(name="safe", display_name="Safe", tool_mode=True, info="Safe name or ID, e.g. Payroll production"),
        MessageTextInput(name="environment", display_name="Environment", tool_mode=True, info="prod / uat. Leave empty if the user did not say"),
        MessageTextInput(name="status", display_name="Status", tool_mode=True,
                         info="Account status (active/disabled) or recertification status (pending/error/certified)"),
        MessageTextInput(name="rotation_status", display_name="Rotation status", tool_mode=True, info="success / failed"),
        MessageTextInput(name="platform", display_name="Platform", tool_mode=True, info="e.g. windows domain"),
        MessageTextInput(name="category", display_name="Platform category", tool_mode=True, info="e.g. database"),
        MessageTextInput(name="user_query", display_name="Original user message", tool_mode=True,
                         info="Copy the user's message verbatim (used for injection screening)"),
    ]
    outputs = [Output(display_name="Result", name="result", method="run_query")]

    def run_query(self) -> Data:
        d = Path(self.data_dir) if (self.data_dir or "").strip() else None
        if d and (d / "pam_store.json").exists():
            store = json.loads((d / "pam_store.json").read_text())
            rf = d / "recertification.json"
            recert = json.loads(rf.read_text()) if rf.exists() else None
        else:
            store, recert = EMBEDDED_STORE, EMBEDDED_RECERT
        uid = (self.user_id or "").strip()
        user = store["users"].get(uid)
        if not user:
            return Data(data={"decision": "DENY", "reason_code": "UNKNOWN_USER", "results": [], "follow_up": None})
        req = {"user_id": uid, **user}
        params = {k: getattr(self, k, None) for k in
                  ("keyword", "account_id", "safe", "environment", "status", "rotation_status",
                   "platform", "category", "user_query")}
        res = evaluate(self.intent, params, req, store, store.get("policy", {}), recert,
                       (self.outage_mode or "off").strip().lower())
        entry = audit_entry(req, res["intent"], params, res)
        try:  # every call is logged (Security / Compliance requirement)
            log = (d / "audit_log.jsonl") if d else Path("/tmp/pam_audit_log.jsonl")
            with open(log, "a") as f:
                f.write(json.dumps(entry) + "\n")
        except OSError:
            pass
        self.status = f"{res['decision']} / {res['reason_code']}"
        return Data(data=public_view(res))
